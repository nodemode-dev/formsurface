#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
usage() {
  cat << 'EOF2'
formsurface 0.37.0 · 3D texture painting

usage: ./formsurface [command]

  (none) | boot   build the engine if needed, then boot backend (8766) and frontend (5176)
  install         install the Rust wasm target, wasm-bindgen, backend venv and frontend packages
  engine          rebuild the Rust engine into frontend/src/engine/pkg
  backend         boot the backend only
  frontend        boot the frontend only
  mcp             FormSurface over MCP's stdio transport (starts the service if needed)
  batch FILE      run a JSON batch script of formsurface_* tool calls against the linked editor
                  (--wait SECONDS for the Agent link, --out DIR for screenshots, --pause SECONDS
                  between steps, --keep-going; --headless [--size 1024|2048|4096] starts the
                  service, the editor and a windowless Chrome, Chromium or Edge, then stops them)
  script FILE     run a Python script that imports formsurface_api (project, textureset,
                  layerstack, baking, export, resource, display) against the linked editor
                  (script --headless [--size N] FILE runs it without an open editor)
  help            this text
EOF2
}
cmd="${1:-boot}"
case "$cmd" in
  boot) [ -f frontend/src/engine/pkg/fs_engine.js ] || setup/build_engine; (cd backend && ./boot_backend) & (cd frontend && ./boot_frontend) & wait ;;
  install) exec ./formsurface_oc_install ;;
  engine) exec setup/build_engine ;;
  backend) cd backend && exec ./boot_backend ;;
  frontend) cd frontend && exec ./boot_frontend ;;
  mcp) exec mcp/launch ;;
  batch) shift; [ -x backend/venv/bin/python ] || { echo "Run ./formsurface install first" >&2; exit 1; }; exec backend/venv/bin/python -I mcp/batch.py "$@" ;;
  script) shift; [ -x backend/venv/bin/python ] || { echo "Run ./formsurface install first" >&2; exit 1; }; exec backend/venv/bin/python -I mcp/run_script.py "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
