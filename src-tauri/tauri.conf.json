{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormSurface",
  "version": "0.59.1",
  "identifier": "ai.nodemode.formsurface",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FormSurface",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "3D texture painting",
    "longDescription": "FormSurface paints PBR textures on 3D models with layers, masks, fills, intelligent materials, baking and export templates, with Claude Code built in.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formsurface-engine"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formcompiler/releases/download/formsurface-updates/latest.json"]
    }
  }
}
